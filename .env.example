# ClinicalTrials.gov XML snapshot
CLINICAL_TRIALS_XML_DIR=data/clinical_trials
NCBI_EMAIL=your_email@example.com

# Endpoint originally used to formulate benchmark questions
BENCHMARK_LLM_ENDPOINT=
BENCHMARK_LLM_API_KEY=
BENCHMARK_LLM_CHANNEL_ID=

# OpenSearch connection
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=replace_me
OPENSEARCH_INDEX_NAME=clinical_trials_bm25_v1
OPENSEARCH_URL_PREFIX=
OPENSEARCH_USE_SSL=false
OPENSEARCH_VERIFY_CERTS=false

# Optional remote OpenAI-compatible endpoint instead of local vLLM
LLM_API_MODE=vllm
EXTERNAL_OPENAI_BASE_URL=
EXTERNAL_OPENAI_API_KEY=

# Gemma endpoint used by the report-alignment judge
GEMMA_API_BASE=http://127.0.0.1:8000/v1
GEMMA_API_KEY=replace_me
GEMMA_MODEL=google/gemma-4-31B-it

# Local execution defaults
VLLM_GPU=0
VLLM_PORT=8601
VLLM_GPU_MEMORY_UTILIZATION=0.70
